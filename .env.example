# Django secret key used for cryptographic signing (sessions, CSRF, etc.).
# Generate a unique, random value per environment and never commit the real value.
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key

# Enables Django debug mode. Must be "False" in any deployed environment.
DJANGO_DEBUG=True

# Comma-separated list of hostnames/domains this Django instance may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins (scheme + host + optional port) trusted for
# CSRF-protected POST/PUT/PATCH/DELETE requests, e.g. https://meetingspace.example.com.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Whether to enforce HTTPS-only cookies and redirects ("True" in production).
DJANGO_SECURE_HTTPS=False

# Name of the PostgreSQL database used by the backend.
POSTGRES_DB=meetingspace

# PostgreSQL username.
POSTGRES_USER=meetingspace

# PostgreSQL password. Use a strong, unique value per environment.
POSTGRES_PASSWORD=change-me

# Hostname of the PostgreSQL server (the Docker Compose service name in local dev).
POSTGRES_HOST=db

# Port the PostgreSQL server listens on.
POSTGRES_PORT=5432

# IANA time zone used for displaying and storing booking times (default Asia/Tokyo).
APP_TIME_ZONE=Asia/Tokyo
